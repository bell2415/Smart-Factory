                            Console.WriteLine("b키를 입력");
                            break;
                        }
                    case (int)'B':
                        {
                            Console.WriteLine("B키를 입력");
                            break;
                        }
                    case 0X250000:
                        {
                            Console.WriteLine("왼쪽화살표를 입력");
                            break;
                        }
                    case 0X260000:
                        {
                            Console.WriteLine("위쪽화살표를 입력");
                            break;
                        }
                    case 0X270000:
                        {
                            Console.WriteLine("오른쪽화살표를 입력");

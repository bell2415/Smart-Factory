            //string title1 = "white창 제어";
            string title1 = "키보드 이벤트 - Window-autosize";
            Cv2.ImShow("키보드 이벤트", image1);
            int a;
            while (true)
            {
                int key = Cv2.WaitKeyEx(100);
                if (key == 27) // ESC
                    break;

                switch (key)
                {
                    case (int)'a':
                        {
                            Console.WriteLine("a키를 입력");
                            break;
                        }
                    case (int)'A':
                        {
                            Console.WriteLine("A키를 입력");
                            break;
                        }
                    case (int)'b':

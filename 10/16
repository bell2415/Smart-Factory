using OpenCvSharp;

class Program
{
    static Mat image;
    static string title = "트랙바 이벤트";

    static void onChange(int value, IntPtr userdata)
    {
        int add_value = value - 130;
        System.Console.WriteLine("추가 화소값: " + add_value);

        // 새로운 Mat을 생성하고, Add 함수를 사용하여 값을 더함
        Mat tmp = new Mat();
        Cv2.Add(image, new Scalar(add_value), tmp);

        Cv2.ImShow(title, tmp);
    }

    static void Main(string[] args)
    {
        int value = 128;
        image = new Mat(300, 400, MatType.CV_8UC1, Scalar.All(128));

        Cv2.NamedWindow(title, WindowFlags.AutoSize);
        Cv2.CreateTrackbar("밝기값", title, ref value, 255, onChange);

        Cv2.ImShow(title, image);
        Cv2.WaitKey(0);
    }
}

using OpenCvSharp;



namespace ConsoleApp137

{



    internal class Program

    {

        static void Main(string[] args)

        {

            Scalar blue = new Scalar(255, 0, 0);

            Scalar red = new Scalar(0, 0, 255);

            Scalar green = new Scalar(0, 255, 0);

            Scalar white = new Scalar(255, 255, 255);

            Scalar yellow = new Scalar(0, 255, 255);

            Scalar black = new Scalar(0, 0, 0);



            Mat image = new Mat(600, 600, MatType.CV_8UC3, white);



            Point pt1 = new Point(200, 200);

            Point pt2 = new Point(200, 400);

            Point pt3 = new Point(400, 200);

            Point pt4 = new Point(400, 400);

            Point pt5 = new Point(300, 300);

            Point pt6 = new Point(300, 100);



            Rect rect = new Rect(pt1, new Size(200, 200));

            //라인

            Cv2.Line(image, pt1, pt4, blue, 1, LineTypes.AntiAlias); // 줄 그리기

            Cv2.Line(image, pt3, pt2, blue, 1, LineTypes.AntiAlias);

            //Cv2.Line(image, pt3, pt4, green, 3, LineTypes.Link8, 1);

            ////사각형 그리기

            Cv2.Rectangle(image, rect, black, 1, LineTypes.AntiAlias);

            //원 그리기

            Cv2.Circle(image, pt5, 100, blue, -1, LineTypes.AntiAlias);

            //삼각형 그리기

            Point[] trianglePoints = { pt1, pt3, pt6 };

            Cv2.Polylines(image, new[] { trianglePoints }, true, red, 1, LineTypes.AntiAlias);

            Cv2.FillPoly(image, new[] { trianglePoints }, red);

            //출력

            Cv2.ImShow("image", image);

            Cv2.WaitKey(0);

            Cv2.DestroyAllWindows();







        }

    }

}

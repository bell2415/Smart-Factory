using OpenCvSharp;

namespace ConsoleApp122
{
    internal class Program
    {
        static void Main(string[] args)
        {
            // 이미지 파일 경로 설정
            string imagePath = "C:\\Temp\\pic1.png";

            // 이미지 로드
            Mat BGR_img = Cv2.ImRead(imagePath, ImreadModes.Color);
            if (BGR_img.Empty())
            {
                Console.WriteLine("이미지를 불러올 수 없습니다.");
                return;
            }

            // 흰색 스칼라 (255, 255, 255)
            Scalar white = new Scalar(255, 255, 255);

            // CMY 이미지 생성: CMY = 흰색 - BGR
            Mat CMY_img = new Mat();
            Cv2.Subtract(white, BGR_img, CMY_img);

            // CMY 채널 분리
            Mat[] CMY_arr = Cv2.Split(CMY_img);

            // 이미지 출력
            Cv2.ImShow("BGR Image", BGR_img);
            Cv2.ImShow("CMY Image", CMY_img);
            Cv2.ImShow("Yellow Channel", CMY_arr[0]); // 노랑색 채널
            Cv2.ImShow("Magenta Channel", CMY_arr[1]); // 다홍색 채널
            Cv2.ImShow("Cyan Channel", CMY_arr[2]); // 청록색 채널

            // 키 입력 대기
            Cv2.WaitKey(0);
            Cv2.DestroyAllWindows();
        }
    }
}

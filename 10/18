using OpenCvSharp;
using System;
namespace ConsoleApp116
{
    internal class Program
    {
        static void Main(string[] args)
        {
            string imagePath = @"c:/Temp/test2.jpg";
            Mat image = Cv2.ImRead(imagePath, ImreadModes.Color);
            if (image.Empty())
            {
                throw new Exception("이미지를 불러올 수 없습니다.");
            }
            Mat[] channels;
            Cv2.Split(image, out channels);
            for (int i = 0; i < 3; i++)
            {
                double minVal, maxVal;
                Cv2.MinMaxIdx(channels[i], out minVal, out maxVal);
                double ratio = (maxVal - minVal) / 255;
                channels[i].ConvertTo(channels[i], MatType.CV_64F);
                Cv2.Subtract(channels[i], new Scalar(minVal), channels[i]);
                Cv2.Divide(channels[i], new Scalar(ratio), channels[i]);
                channels[i].ConvertTo(channels[i], MatType.CV_8U);
            }
            Mat dst = new Mat();
            Cv2.Merge(channels, dst);
            Cv2.ImShow("image", image);
            Cv2.ImShow("dst", dst);
            Cv2.WaitKey();
            Cv2.DestroyAllWindows();
        }
    }
}



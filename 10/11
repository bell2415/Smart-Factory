#include <WiFi.h>
#include <PubSubClient.h>
#include <BH1750.h>
#include <Wire.h>
#include "DHT.h"
#include <Adafruit_SSD1306.h>
#include <Adafruit_GFX.h>
#include <gfxfont.h>

#define PAYLOAD_MAXSIZE 64
#define DHTPIN 4  
#define DHTTYPE DHT11
#define LED_PIN D2  // D2 핀에 연결된 LED (ESP32 보드에서 D2에 해당하는 핀)
#define OLED_RESET 0  
Adafruit_SSD1306 display(OLED_RESET);

DHT dht(DHTPIN, DHTTYPE);  // DHT11 센서 설정
BH1750 lightMeter;         // BH1750 조도 센서 설정

// WiFi 및 MQTT 설정
const char* ssid = "pcroom";
const char* password = "12345678";
const char* userId = "mqtt_ship";
const char* userPw = "1234";
const char* clientId = userId;
char* topic = "MyOffice/Indoor/SensorValue";
char* server = "192.168.0.43"; 

WiFiClient wifiClient; 
PubSubClient client(server, 1883, wifiClient);

unsigned long lastSensorReadTime = 0;
unsigned long lastLedBlinkTime = 0;
bool isLedOn = false;

void setup() {
  Serial.begin(9600);

  // WiFi 연결
  Serial.print("\nConnecting to ");
  Serial.println(ssid);
  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED) {
    Serial.print(".");
    delay(1000);
  }
  Serial.println("\nWiFi Connected");

  // MQTT 브로커 연결
  Serial.println("Connecting to broker");
  while (!client.connect(clientId, userId, userPw)) { 
    Serial.print("*");
    delay(1000);
  }
  Serial.println("\nConnected to broker");

  // DHT11 및 BH1750 센서 초기화
  dht.begin();
  Wire.begin();
  lightMeter.begin();

  // OLED 디스플레이 초기화
  display.begin(SSD1306_SWITCHCAPVCC, 0x3C);
  display.clearDisplay();
  display.setTextColor(WHITE);
  display.setTextSize(1);  // 텍스트 크기 설정

  // D2에 연결된 LED 핀 설정
  pinMode(LED_PIN, OUTPUT);
  digitalWrite(LED_PIN, HIGH); // LED 초기 상태는 꺼진 상태 (HIGH가 꺼짐)
}

void loop() {
  // 현재 시간 가져오기
  unsigned long currentMillis = millis();

  // 2초마다 센서 데이터를 읽고 MQTT로 전송
  if (currentMillis - lastSensorReadTime >= 2000) {
    lastSensorReadTime = currentMillis;
    
    // DHT11 센서에서 온도와 습도 읽기
    float h = dht.readHumidity();
    float t = dht.readTemperature();
    
    // BH1750 센서에서 조도 값 읽기
    float l = lightMeter.readLightLevel();

    // 센서 값이 유효한지 확인
    if (isnan(h) || isnan(t) || isnan(l)) {
      Serial.println("Failed to read from sensors!");
      return;
    }

    // JSON 형태의 메시지 생성
    char payload[PAYLOAD_MAXSIZE];
    String sPayload = "{'Temp':" 
                      + String(t, 1) 
                      + ",'Humi':" 
                      + String(h, 1) 
                      + ",'Lux':" 
                      + String(l, 1) 
                      + "}";
    
    // String을 char 배열로 변환하여 MQTT로 퍼블리시
    sPayload.toCharArray(payload, PAYLOAD_MAXSIZE);
    client.publish(topic, payload);

    // 시리얼 모니터에 출력
    Serial.print(String(topic) + " ");
    Serial.println(payload);

    // OLED 디스플레이에 센서 데이터 또는 경고 메시지 표시
    display.clearDisplay();
    if (l > 1000) {
      // 조도 값이 1000 이상일 때 WARNING 메시지 표시
      display.setTextSize(2);  // 텍스트 크기 2로 설정
      display.setCursor(0, 20);
      display.println("WARNING!");
      display.setTextSize(1);  // 텍스트 크기 다시 1로 설정
    } else {
      // 조도 값이 1000 이하일 때 기본 센서 데이터 표시
      display.setCursor(0, 0);
      display.println("Sensor Data");
      display.print("Temp: ");
      display.print(t);
      display.println(" C");
      display.print("Humi: ");
      display.print(h);
      display.println(" %");
      display.print("Lux: ");
      display.print(l);
      display.println(" lx");
    }
    display.display();
    
    // 조도 값에 따라 LED 상태 업데이트
    if (l > 1000) {
      Serial.println("Lux over 1000! Blinking LED...");
    } else {
      // 조도가 1000 이하일 때 LED 끄기
      digitalWrite(LED_PIN, HIGH);
      isLedOn = false;
    }
  }

  // 조도가 1000 이상일 때 0.5초마다 LED 상태를 반전 (깜빡임)
  if (lightMeter.readLightLevel() > 1000) {
    if (currentMillis - lastLedBlinkTime >= 500) {
      lastLedBlinkTime = currentMillis;
      
      // LED 상태 반전
      isLedOn = !isLedOn;
      digitalWrite(LED_PIN, isLedOn ? LOW : HIGH); // LOW가 켜짐, HIGH가 꺼짐
    }
  }

  client.loop(); // MQTT 메시지 대기 및 처리
}

